PORT=5000
NODE_ENV=development
LOG_LEVEL=info
CLIENT_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/aarogya_drishti?replicaSet=rs0
SIMULATION_MODE=true
AGENDA_PROCESS_EVERY=5 seconds
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters

# Google Gemini Multimodal Vision & Chatbot Integration
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Google Cloud Storage Configuration (Official @google-cloud/storage)
GCP_PROJECT_ID=aarogya-drishti-paderu
GCS_BUCKET_NAME=aarogya-drishti-telehealth-storage
GCS_KEY_FILE=

# Real Daily.co Video Consultation adapter. Optional when configured in the system-admin UI.
# Never put these values in client/.env or frontend source.
# Create an API key in https://dashboard.daily.co/ and set the account domain,
# for example your-team.daily.co (without https://).
DAILY_API_KEY=
DAILY_DOMAIN=

# Required for admin-configured Daily credentials. Generate once with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep this persistent across server restarts and backups; losing it makes the
# encrypted Daily API key unreadable. It is not the Daily API key itself.
VIDEO_CONFIG_ENCRYPTION_KEY=

# Appointment WebRTC ICE servers. Configure TURN for restrictive networks.
# Keep TURN credentials server-side; do not add these values to client/.env.
STUN_URLS=stun:stun.l.google.com:19302
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
