# =========================================================================
# Aarogya-Drishti: Production Environment Secrets Configuration Template
# Copy to .env.production and fill with real operational values.
# NEVER commit .env.production to version control!
# =========================================================================

# Runtime Mode
NODE_ENV=production
PORT=5000
LOG_LEVEL=info
SIMULATION_MODE=true

# Domain & Client Routing
CLIENT_ORIGIN=https://aarogya-drishti.paderu.itda.demo
PUBLIC_API_URL=https://aarogya-drishti.paderu.itda.demo/api/v1

# MongoDB Replica Set (With Authentication & TLS in Production)
MONGODB_URI=mongodb://aarogya_admin:CHANGE_ME_SECURE_PASSWORD@mongo:27017/aarogya_drishti?replicaSet=rs0&authSource=admin

# Background Job Scheduler
AGENDA_PROCESS_EVERY=10 seconds

# Cryptographic Keys (Must be 64-character hex strings in production)
# Generate via: openssl rand -hex 32
JWT_ACCESS_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32
JWT_REFRESH_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32
FILE_ENCRYPTION_KEY=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32

# Storage Directory Path
STORAGE_DIR=/app/storage/private_uploads

# Rate Limiting & DoS Protection
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120

# TLS Certificate Paths (Mounted into Nginx reverse proxy)
TLS_CERT_PATH=./deployment/tls/fullchain.pem
TLS_KEY_PATH=./deployment/tls/privkey.pem
